<Window x:Class="Usage.App.ChipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Usage"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        Opacity="0"
        SizeToContent="WidthAndHeight">
    <Border x:Name="Root" Background="Transparent" Padding="10,0">
        <TextBlock FontFamily="Segoe UI"
                   FontWeight="SemiBold"
                   FontSize="13"
                   TextOptions.TextFormattingMode="Ideal"
                   TextOptions.TextRenderingMode="ClearType">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.85"/>
            </TextBlock.Effect>
            <Run x:Name="ClaudeRun" Text="Claude --"/>
            <Run x:Name="SeparatorRun" Text="  ·  " Foreground="#FF8A8F94"/>
            <Run x:Name="CodexRun" Text="Codex --"/>
        </TextBlock>
    </Border>
</Window>
